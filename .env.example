# ─── API ───────────────────────────────────────────────────
APP_NAME=ReconFace
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Face Engine ───────────────────────────────────────────
FACE_MODEL_NAME=buffalo_l
FACE_DET_SIZE=640
# Device setting: 0 = GPU / Neural Engine (Auto-detects CUDA / CoreML / DirectML), -1 = CPU
FACE_CTX_ID=0
# Optional provider override: auto, CUDA, CoreML, DML, CPU (leave empty for auto)
EXECUTION_PROVIDER_OVERRIDE=
FACE_MIN_SIZE=24
FACE_BLUR_THRESHOLD=30.0

# ─── Storage & Dataset Paths (Optional Overrides) ──────────
# Defaults to auto-resolving relative to repository root if not set
# DATASET_DIR=/path/to/dataset_dusit
# TEMP_DIR=/path/to/temp_web_scans

# ─── Qdrant ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=reconface_vectors
QDRANT_IN_MEMORY=false

# ─── Redis / Celery ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── MinIO / S3 ───────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ORIGINALS=recon-originals
MINIO_BUCKET_FACES=recon-faces

# ─── Search Defaults ──────────────────────────────────────
SEARCH_DEFAULT_TOP_K=10
SEARCH_DEFAULT_THRESHOLD=0.6
